# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ===========================================
# Security Configuration (REQUIRED)
# ===========================================
# Generate a secure secret: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===========================================
# Environment Settings
# ===========================================
# Set to 'production' for Vercel deployments
APP_ENV=production

# Disable Swagger docs in production
ENABLE_API_DOCS=false

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins
# For Vercel: https://your-domain.vercel.app
CORS_ORIGINS=https://your-domain.vercel.app,https://www.your-domain.vercel.app

# ===========================================
# Redis Cache (Optional)
# ===========================================
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS_CACHE=false
REDIS_CACHE_TTL_SECONDS=300

# ===========================================
# OpenRouter API (Required)
# ===========================================
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary chat model
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# ===========================================
# LLM Configuration
# ===========================================
CHAT_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0

# ===========================================
# Embeddings Configuration (Required for RAG)
# ===========================================
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_EMBEDDING_DIM=2048
RAG_ACTIVE_EMBEDDING_INDEX=nvidia
EMBEDDING_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=16

# ===========================================
# RAG Chunking Configuration
# ===========================================
CHUNK_SIZE_CHARS=1400
CHUNK_OVERLAP_CHARS=200
CHUNK_MIN_CHARS=80

# ===========================================
# Retrieval Tuning
# ===========================================
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
FUSED_TOP_K=10
FINAL_TOP_K=4

# ===========================================
# RAG Features
# ===========================================
ENABLE_RERANKER=false
ENABLE_METADATA_EXTRACTION=true
ENABLE_HALLUCINATION_CHECK=false
MAX_GENERATION_RETRIES=0
AGENT_MAX_TOOL_LOOPS=3
MEMORY_WINDOW_MESSAGES=10

# ===========================================
# Knowledge Documents Directory
# ===========================================
KNOWLEDGE_DOCS_DIR=documents
