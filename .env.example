DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
APP_ENV=development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENABLE_API_DOCS=false
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS_CACHE=false
REDIS_CACHE_TTL_SECONDS=300
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_FALLBACK_MODELS=
GROQ_API_KEY=
GROQ_MODEL=
CHAT_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
OPENROUTER_EMBEDDING_MODEL=replace-with-your-configured-embedding-model
OPENROUTER_EMBEDDING_DIM=2048
RAG_ACTIVE_EMBEDDING_INDEX=nvidia
EMBEDDING_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=180
CHUNK_MIN_CHARS=80
DENSE_TOP_K=16
SPARSE_TOP_K=16
RRF_K=60
FUSED_TOP_K=8
FINAL_TOP_K=4
ENABLE_RERANKER=false
ENABLE_METADATA_EXTRACTION=true
ENABLE_HALLUCINATION_CHECK=true
MAX_GENERATION_RETRIES=1
AGENT_MAX_TOOL_LOOPS=6
MEMORY_WINDOW_MESSAGES=10
